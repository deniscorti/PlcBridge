{
  "Bridge": {
    "Mode": "DataProvider",
    "Http": { "Port": 5080 },

    "WebSocket": {
      "Path": "/ws",
      "MaxConnections": 100,
      "MaxSubscriptionsPerClient": 200,
      "MaxQueriesPerMinute": 60,
      "MaxMessageQueueSize": 10000,
      "CompactFlushMs": 50
    },

    "Auth": {
      "ApiKey": "",
      "JwtSecret": ""
    },

    "CommandTimeoutMs": 5000,
    "HeartbeatIntervalMs": 10000,
    "HeartbeatMaxMissed": 3,

    // ═══════════════════════════════════════════════════════════════
    // DataSources: elenco delle sorgenti dati gestite da questo nodo.
    // Ogni DataSource ha un Id univoco e uno o piu' Input.
    //
    // Tipi di Input disponibili:
    //
    //   "Mock"  — Simulatore interno: genera dati finti (sine wave, eventi casuali).
    //             NON legge da nessun dispositivo reale. Utile SOLO per test/sviluppo.
    //             I tag definiti qui producono valori automatici senza hardware.
    //
    //   "Ads"   — Beckhoff TwinCAT ADS: legge variabili PLC via protocollo ADS/AMS.
    //             Richiede Host (IP del PLC), AmsNetId, Port (tipicamente 851).
    //             Ogni tag ha un Address (es. "MAIN.fTemperature") che mappa la variabile PLC.
    //             PollMs = intervallo di lettura in millisecondi.
    //
    //   "Udp"   — Ricezione pacchetti UDP: ascolta su una porta e decodifica pacchetti
    //             binari inviati dal PLC o da un simulatore esterno (es. UdpSimulator).
    //             ListenPort = porta UDP su cui ascoltare.
    //             Protocol = formato pacchetto ("custom-v1").
    //             AutoDiscovery = se true, i tag vengono scoperti automaticamente
    //             dal contenuto dei pacchetti (non serve definirli qui).
    //
    // Un DataSource puo' avere piu' Input contemporaneamente (es. ADS + UDP).
    // Con Enabled=false la sorgente viene ignorata (ma resta visibile come esempio).
    // ═══════════════════════════════════════════════════════════════

    "DataSources": [
      {
        "Enabled": true,
        "Id": "mock-source",
        "Comment": "Simulatore per test — genera dati finti, nessun PLC reale",
        "Inputs": [
          {
            "Type": "Mock",
            "Tags": [
              { "Name": "temperature", "DataKind": "Telemetry", "PollMs": 500 },
              { "Name": "pressure",    "DataKind": "Telemetry", "PollMs": 1000 },
              { "Name": "setpoint",    "DataKind": "Telemetry", "PollMs": 1000 },
              { "Name": "startButton", "DataKind": "Event" },
              { "Name": "overtemp",    "DataKind": "Alarm" }
            ]
          }
        ]
      },
      {
        "Enabled": false,
        "Id": "plc-linea1",
        "Comment": "Esempio PLC reale via ADS — abilitare e configurare Host/AmsNetId per usarlo",
        "Inputs": [
          {
            "Type": "Ads",
            "Host": "192.168.0.10",
            "AmsNetId": "5.23.40.1.1.1",
            "Port": 851,
            "Tags": [
              { "Name": "temperature", "Address": "MAIN.fTemperature", "DataKind": "Telemetry", "PollMs": 500 },
              { "Name": "setpoint",    "Address": "MAIN.fSetpoint",    "DataKind": "Telemetry", "PollMs": 1000 },
              { "Name": "startButton", "Address": "MAIN.bStart",       "DataKind": "Event" },
              { "Name": "overtemp",    "Address": "MAIN.bOverTemp",    "DataKind": "Alarm" }
            ]
          }
        ]
      },
      {
        "Enabled": false,
        "Id": "plc-udp",
        "Comment": "Esempio ricezione UDP — ascolta pacchetti binari da PLC o simulatore esterno",
        "Inputs": [
          {
            "Type": "Udp",
            "ListenPort": 9100,
            "Protocol": "custom-v1",
            "AutoDiscovery": true,
            "Tags": []
          }
        ]
      }
    ]
  },

  "Serilog": {
    "MinimumLevel": "Information"
  }
}
