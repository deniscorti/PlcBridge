{
  "Bridge": {
    "Mode": "DataServer",
    "Http": { "Port": 5082 },

    "WebSocket": {
      "Path": "/ws",
      "MaxConnections": 2000,
      "MaxSubscriptionsPerClient": 500,
      "MaxQueriesPerMinute": 120,
      "MaxMessageQueueSize": 50000,
      "CompactFlushMs": 50
    },

    "Auth": {
      "ApiKey": "",
      "JwtSecret": ""
    },

    "CommandTimeoutMs": 10000,
    "HeartbeatIntervalMs": 10000,
    "HeartbeatMaxMissed": 3,

    // ═══════════════════════════════════════════════════════════════
    // Buffer: ring buffer in memoria. Il DataServer tiene un buffer
    // piu' ampio (es. 300 min = 5 ore) per storico e replay.
    //
    //   ParquetArchivePath — cartella dove il DataServer:
    //     1) SALVA automaticamente i chunk ricevuti via chunk transfer
    //        dal DataService (cosi' restano disponibili anche dopo un riavvio)
    //     2) CARICA file Parquet per analisi offline su richiesta
    //        (via API: POST /archives/load o /archives/load-range)
    //
    //   I file possono anche essere copiati manualmente in questa cartella
    //   (es. da NAS, sync, copia dal DataService) e poi caricati via API.
    // ═══════════════════════════════════════════════════════════════

    "Buffer": {
      "Enabled": true,
      "InMemoryMinutes": 300,
      "ChunkDurationMin": 5,
      "PersistToDisk": false,
      "ParquetOutputPath": "./data/parquet",
      "ParquetArchivePath": "./data/archives",
      "HistoricalDataPath": "./data/historical"
    },

    // ═══════════════════════════════════════════════════════════════
    // SelectiveSubscription: se true, il DataServer NON sottoscrive
    // tutti i tag dall'upstream. Sottoscrive solo i canali che i client
    // (dashboard) richiedono in quel momento. Risparmia banda upstream.
    //
    // BackfillMinutes: quando un client sottoscrive un canale per la
    // prima volta, il DataServer recupera N minuti di storia dall'upstream.
    // ═══════════════════════════════════════════════════════════════

    "SelectiveSubscription": true,
    "BackfillMinutes": 60,

    // ═══════════════════════════════════════════════════════════════
    // Sources: connessioni WebSocket UPSTREAM.
    // Il DataServer si collega come CLIENT al DataService per ricevere:
    //   - dati live (telemetria, eventi, allarmi)
    //   - notifiche chunkReady (per chunk transfer)
    //
    //   AutoDiscovery — se true, scopre tutti i tag dall'upstream (ignora Tags)
    //   Tags          — lista esplicita di tag (ignorata se AutoDiscovery=true)
    //   ChunkSync     — se true, quando il DataService notifica un chunk sealed,
    //                   il DataServer lo richiede e lo inserisce in memoria
    //                   come chunk "Full" (colma i buchi del live streaming)
    // ═══════════════════════════════════════════════════════════════

    "Sources": [
      {
        "Enabled": true,
        "Id": "upstream-service",
        "Url": "ws://localhost:5081/ws",
        "ApiKey": "",
        "AutoDiscovery": true,
        "Tags": [],
        "ForwardIntervalMs": 2000,
        "Compression": "none",
        "BatchMode": false,
        "ChunkSync": true,
        "ChunkSyncMaxBandwidthKbps": 100
      }
    ],

    // ═══════════════════════════════════════════════════════════════
    // UdpReceiver: ricezione stream UDP dal DataService.
    // Canale opzionale a bassa latenza, complementare al WebSocket.
    // Il DataServer deduplica automaticamente i dati ricevuti sia
    // via UDP che via WS tramite msgId.
    //
    //   AutoDiscovery — se true, accetta qualsiasi source dallo stream
    //   Tags          — lista esplicita di tag (ignorata se AutoDiscovery=true)
    // ═══════════════════════════════════════════════════════════════

    "UdpReceiver": {
      "Enabled": false,
      "ListenPort": 9200,
      "AutoDiscovery": true,
      "Tags": []
    }
  },

  "Serilog": {
    "MinimumLevel": "Information"
  }
}
