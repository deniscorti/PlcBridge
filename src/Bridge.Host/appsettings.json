{
  "Bridge": {
    "Mode": "DataService",
    "Http": { "Port": 5080 },
    "Buffer": {
      "InMemoryMinutes": 60,
      "ChunkDurationMin": 5,
      "PersistToDisk": true,
      "ReadFromDisk": false
    },
    "DataSources": [
      {
        "Id": "udp-receiver",
        "Inputs": [
          {
            "Type": "Udp",
            "ListenPort": 9100,
            "Protocol": "custom-v1",
            "AutoDiscovery": true
          }
        ]
      }
    ]
  }
}
