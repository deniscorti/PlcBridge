{
  "Bridge": {
    "Mode": "DataServer",
    "Http": { "Port": 5082 },
    "WebSocket": { "Path": "/ws" },
    "Buffer": {
      "InMemoryMinutes": 20,
      "ChunkDurationMin": 2,
      "ParquetArchivePath": "./data/archives"
    },
    "SelectiveSubscription": true,
    "BackfillMinutes": 10,
    "Sources": [
      {
        "Id": "upstream-service",
        "DataSource": "mock-source",
        "Url": "ws://localhost:5081/ws",
        "ChunkSync": true
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
