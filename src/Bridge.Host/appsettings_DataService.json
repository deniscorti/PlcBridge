{
  "Bridge": {
    "Mode": "DataService",
    "Http": { "Port": 5081 },
    "Buffer": {
      "InMemoryMinutes": 10,
      "ChunkDurationMin": 2,
      "PersistToDisk": true,
      "ReadFromDisk": false,
      "ParquetOutputPath": "./data/parquet"
    },
    "Sources": [
      {
        "Id": "upstream-provider",
        "DataSource": "mock-source",
        "Url": "ws://localhost:5080/ws"
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
